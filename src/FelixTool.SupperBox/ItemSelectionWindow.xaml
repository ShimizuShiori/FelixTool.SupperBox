<Window x:Class="FelixTool.SupperBox.ItemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择条目"
        Width="760"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="20"
            Padding="20"
            Background="#FA1F2229"
            BorderBrush="#596275"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Margin="4,0,4,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#F8F8F2" />
            <ListBox x:Name="ItemList"
                     MaxHeight="420"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#F8F8F2"
                     MouseDoubleClick="ItemList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Margin="0,2" Background="#FF303642" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Label}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#B8C1D1"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="4,12,4,0"
                       Foreground="#AEB7C6"
                       Text="↑/↓ 选择，Enter 确认，Esc 取消" />
        </StackPanel>
    </Border>
</Window>
