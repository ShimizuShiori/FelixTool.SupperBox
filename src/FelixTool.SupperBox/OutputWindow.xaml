<Window x:Class="FelixTool.SupperBox.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="20"
            Padding="20"
            Background="#FA1F2229"
            BorderBrush="#596275"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="OutputText"
                     Padding="14"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="16"
                     Foreground="#F8F8F2"
                     Background="#FF2B303B"
                     BorderBrush="#697386"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="输出内容" />
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#AEB7C6" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="96"
                            Margin="0,0,10,0"
                            Padding="12,7"
                            Content="复制"
                            Click="CopyButton_Click" />
                    <Button Width="96"
                            Padding="12,7"
                            Content="关闭"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
